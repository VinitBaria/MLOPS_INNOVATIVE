# ============================================
# Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movie_rec_db
POSTGRES_USER=movie_rec_user
POSTGRES_PASSWORD=movie_rec_pass_2024

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=movie-recommender
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# --- Model ---
MODEL_VERSION=latest
MODEL_NAME=hybrid-recommender
MIN_RECALL_AT_10=0.15
MIN_NDCG_AT_10=0.20

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Retraining ---
RETRAIN_THRESHOLD_NEW_RATINGS=5000
RETRAIN_SCHEDULE_HOURS=24
DRIFT_THRESHOLD=0.1

# --- Docker Registry ---
DOCKER_REGISTRY=localhost:5000
IMAGE_TAG=latest
